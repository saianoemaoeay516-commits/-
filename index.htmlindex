 scene:"全场都在争论，你端起茶杯不发一言。\n半个时辰后，所有人发现你早就把事情的前因后果理清了。",
 danger:"别把沉默当成万能策略。需要表态时，及时说清自己的立场。",
 quote:"“我不是没出手，我是在等这一手值得。”",
 chat:[
  ["other","你刚才为什么一直没说话？"],
  ["user","因为我还没听完。"],
  ["other","现在听完了呢？"],
  ["user","现在我知道谁在说事实，谁在说情绪，谁在等别人先犯错。"],
  ["other","所以你准备怎么办？"],
  ["user","先把茶喝完。真正要紧的事，不差这一盏茶。"]
 ]
},
{
 id:"wei-shu",
 title:"笑着递刀的体面人",
 character:"魏姝",
 vector:[86,67,80,39,89],
 slogan:"场面可以给足，底线不能打折。",
 verdict:[
  "你重视分寸，也很清楚体面并不意味着一味退让。",
  "面对冲突，你会考虑局面、后果和自己的利益，不喜欢无意义地消耗。",
  "你的优势是懂得留余地，风险则是容易让别人猜不透你的真实想法。"
 ],
 scene:"你笑着说：“没关系，我理解。”\n对方刚松一口气，你又补了一句：“不过这件事我们还是按规矩处理。”",
 danger:"别让所有沟通都变成博弈。能坦诚解决的问题，不必绕三圈才说出口。",
 quote:"“体面是礼貌，边界是原则。”",
 chat:[
  ["other","你是不是生气了？"],
  ["user","没有啊。"],
  ["other","那你为什么突然这么客气？"],
  ["user","因为我们现在需要讨论事情，而不是讨论情绪。"],
  ["other","你这样让我有点害怕。"],
  ["user","别怕。流程是公开的，标准也是统一的。"]
 ]
},
{
 id:"zhou-fu",
 title:"人生从不提供标准答案",
 character:"周芙（丽昭仪）",
 vector:[57,52,78,96,53],
 slogan:"我知道每条路都有代价，所以我想认真选一次。",
 verdict:[
  "你会考虑现实，也会认真对待关系中的责任。你不轻易把复杂的人生压缩成简单的对错。",
  "你能够理解别人的处境，却也可能因此背负太多本不属于你的责任。",
  "理解一个人，不代表你必须替他承担所有后果。"
 ],
 scene:"别人问你：“为什么不选最简单的路？”\n你回答：“因为简单不代表适合，正确也不一定毫无代价。”",
 danger:"别因为能理解所有人，就忘了问问自己想要什么。",
 quote:"“我可以理解你的难处，但我也有自己的人生。”",
 chat:[
  ["other","如果两个选择都会让人难过呢？"],
  ["user","那就看看哪一个更符合自己真正想承担的责任。"],
  ["other","没有不伤人的办法吗？"],
  ["user","有时候没有。可我们至少可以诚实，不把选择伪装成命运替我们决定。"],
  ["other","你想得还挺明白。"],
  ["user","明白不代表容易，只是我不想稀里糊涂地活。"]
 ]
},
{
 id:"bi-tao",
 title:"全府最强职场变形金刚",
 character:"碧桃",
 vector:[70,88,68,72,67],
 slogan:"环境可以变，立场可以重新判断，但每一步都得知道自己为什么走。",
 verdict:[
  "你适应环境的速度很快，遇到新局面时会先弄清规则，再寻找自己的位置。",
  "你并不只依赖身份或关系判断一个人，更看重实际处境与行动。",
  "真正重要的是，别为了适应所有环境而逐渐失去自己的原则。"
 ],
 scene:"刚入局时你还在问规矩是什么。\n过了一阵子，别人已经开始问你：“这事应该怎么处理？”",
 danger:"灵活不是没有底线。提前想清楚哪些事情绝不妥协，才能在复杂关系中保留自己。",
 quote:"“我可以随机应变，但不能随机丢掉原则。”",
 chat:[
  ["other","你怎么这么快就适应了新环境？"],
  ["user","先看规则，再看人，最后看自己能做什么。"],
  ["other","那如果规则本身就不合理呢？"],
  ["user","先确认有没有改变它的机会。没有的话，再考虑自己的选择。"],
  ["other","你倒是很现实。"],
  ["user","现实一点，才能有余地去做自己真正想做的事。"]
 ]
}
];

let currentQuestion=0;
let answers=Array(QUESTIONS.length).fill(null);
let finalResult=null;
let finalScores=null;

function showScreen(id){
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  window.scrollTo({top:0,behavior:"smooth"});
}

function startLoading(){
  const btn=document.getElementById("startBtn");
  btn.disabled=true;
  document.getElementById("introLoading").style.display="block";
  const texts=[
    "正在核验入局身份……",
    "正在读取人情关系图谱……",
    "正在加载命格档案……",
    "身份核验完成，欢迎入局。"
  ];
  let progress=0;
  const bar=document.getElementById("introBar");
  const label=document.getElementById("introLoadingText");
  const timer=setInterval(()=>{
    progress+=5+Math.random()*9;
    if(progress>=100)progress=100;
    bar.style.width=progress+"%";
    label.textContent=texts[Math.min(3,Math.floor(progress/26))];
    if(progress>=100){
      clearInterval(timer);
      setTimeout(()=>{
        currentQuestion=0;
        answers=Array(QUESTIONS.length).fill(null);
        renderQuestion();
        showScreen("quiz");
        btn.disabled=false;
      },450);
    }
  },150);
}

function renderQuestion(){
  const q=QUESTIONS[currentQuestion];
  document.getElementById("questionCount").textContent=
    `第 ${currentQuestion+1} 题 / 共 ${QUESTIONS.length} 题`;
  document.getElementById("progressFill").style.width=
    `${(currentQuestion/QUESTIONS.length)*100}%`;
  document.getElementById("chapterName").textContent=q.chapter;
  document.getElementById("questionTitle").textContent=`第 ${currentQuestion+1} 题｜${q.title}`;
  document.getElementById("questionDesc").textContent=q.desc;

  const options=document.getElementById("options");
  options.innerHTML="";
  q.options.forEach((option,index)=>{
    const button=document.createElement("button");
    button.type="button";
    button.className="option"+(answers[currentQuestion]===index?" selected":"");
    button.setAttribute("aria-pressed",answers[currentQuestion]===index?"true":"false");
    const letter=document.createElement("span");
    letter.className="letter";
    letter.textContent=LETTERS[index];
    const text=document.createElement("span");
    text.className="option-text";
    text.textContent=option.text;
    button.append(letter,text);
button.addEventListener("click", function () {
  if (button.disabled) return;

  // 保存当前题目的答案
  answers[currentQuestion] = index;

  // 标记已选选项，并禁止重复点击
  const allButtons = options.querySelectorAll(".option");

  allButtons.forEach(function (item) {
    item.classList.remove("selected");
    item.disabled = true;
  });

  button.classList.add("selected");

  // 同步更新下一题按钮状态
  const next = document.getElementById("nextBtn");
  next.disabled = false;

  // 稍作停顿，再进入下一题
  setTimeout(function () {
    if (currentQuestion >= QUESTIONS.length - 1) {
      beginResultAnalysis();
      return;
    }

    currentQuestion++;
    renderQuestion();

    document.getElementById("quiz").scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }, 180);
});
    options.appendChild(button);
  });

  document.getElementById("prevBtn").disabled=currentQuestion===0;
  const next=document.getElementById("nextBtn");
  next.disabled=answers[currentQuestion]===null;
  next.textContent=currentQuestion===QUESTIONS.length-1?"揭晓我的命格 ✦":"下一题 →";

  const paper=document.getElementById("questionPaper");
  paper.classList.remove("fade-up");
  void paper.offsetWidth;
  paper.classList.add("fade-up");
}

function previousQuestion(){
  if(currentQuestion>0){
    currentQuestion--;
    renderQuestion();
    window.scrollTo({top:0,behavior:"smooth"});
  }
}

function nextQuestion(){
  if(answers[currentQuestion]===null)return;
  if(currentQuestion<QUESTIONS.length-1){
    currentQuestion++;
    renderQuestion();
    window.scrollTo({top:0,behavior:"smooth"});
  }else{
    beginResultAnalysis();
  }
}

function calculateScores(){
  const total = Array(DIMENSIONS.length).fill(0);
  const max = Array(DIMENSIONS.length).fill(0);

  QUESTIONS.forEach((q, qi) => {
    const questionMax = Array(DIMENSIONS.length).fill(-Infinity);

    q.options.forEach(option => {
      option.s.forEach((value, d) => {
        if (value > questionMax[d]) {
          questionMax[d] = value;
        }
      });
    });

    questionMax.forEach((value, d) => {
      if (Number.isFinite(value)) max[d] += value;
    });

    const selected = answers[qi];
    if (selected !== null && q.options[selected]) {
      q.options[selected].s.forEach((value, d) => {
        total[d] += value;
      });
    }
  });

  return total.map((value, d) => {
    if (max[d] <= 0) return 0;
    return Math.round((value / max[d]) * 100);
  });
}

function findBestResult(scores) {
  // 小幅校准，避免某一种人格因偏移量过大而占据绝大多数结果
  // 顺序对应 RESULTS 数组中的 8 种人格
  const calibration = [
    3.77,    // 全府最不好惹的打工人
    0.42,    // 身份焦虑型全场主角
    6.67,    // 全府唯一反诈中心
   -13.37,   // 全府最强护犊子
    1.58,    // 全府最会装没事的人
    9.93,    // 笑着递刀的体面人
   -8.81,    // 人生从不提供标准答案
   -0.21     // 全府最强职场变形金刚
  ];

  let best = null;
  let bestDistance = Infinity;

  RESULTS.forEach((result, i) => {
    let sum = 0;

    for (let d = 0; d < scores.length; d++) {
      sum += (scores[d] - result.vector[d]) ** 2;
    }

    const distance = Math.sqrt(sum / scores.length);
    const adjustedDistance = distance + calibration[i];

    if (adjustedDistance < bestDistance) {
      bestDistance = adjustedDistance;
      best = result;
    }
  });

  return best;
}


function beginResultAnalysis(){
  finalScores=calculateScores();
  finalResult=findBestResult(finalScores);
  showScreen("loadingScreen");
  const bar=document.getElementById("resultBar");
  const percent=document.getElementById("loadingPercent");
  let p=0;
  const timer=setInterval(()=>{
    p=Math.min(100,p+Math.ceil(Math.random()*12));
    bar.style.width=p+"%";
    percent.textContent=p+"%";
    if(p>=100){
      clearInterval(timer);
      setTimeout(()=>{
        renderResult(finalResult,finalScores);
        showScreen("resultScreen");
      },500);
    }
  },170);
}

function addChatMessage(container,type,text,index){
  const row=document.createElement("div");
  row.className="chat-row"+(type==="user"?" user":"");
  const avatar=document.createElement("div");
  avatar.className="mini-avatar";
  avatar.textContent=type==="user"?"你":"人物";
  const content=document.createElement("div");
  const bubble=document.createElement("div");
  bubble.className="bubble";
  bubble.textContent=text;
  const time=document.createElement("div");
  time.className="chat-time";
  time.textContent=`14:${String(8+index*2).padStart(2,"0")}`;
  content.append(bubble,time);
  row.append(avatar,content);
  container.appendChild(row);
}

function renderResult(result,scores){
  document.getElementById("resultTitle").textContent=result.title;
  document.getElementById("resultCharacter").textContent="对应人物："+result.character;
  document.getElementById("resultSlogan").textContent=result.slogan;
  document.getElementById("chatHeadName").textContent=result.character;
  document.getElementById("chatHeadAvatar").textContent=result.character.slice(0,2);

  const verdict=document.getElementById("verdictText");
  verdict.innerHTML="";
  result.verdict.forEach(line=>{
    const p=document.createElement("p");
    p.textContent=line;
    verdict.appendChild(p);
  });

  document.getElementById("sceneText").textContent=result.scene;
  document.getElementById("dangerText").textContent=result.danger;
  document.getElementById("quoteText").textContent="“"+result.quote.replace(/[“”]/g,"")+"”";

  const list=document.getElementById("attributeList");
  list.innerHTML="";
  DIMENSIONS.forEach((name,i)=>{
    const item=document.createElement("div");
    const head=document.createElement("div");
    head.className="attr-head";
    const label=document.createElement("span");
    label.textContent=name;
    const value=document.createElement("span");
    value.textContent=scores[i];
    head.append(label,value);
    const track=document.createElement("div");
    track.className="attr-track";
    const fill=document.createElement("div");
    fill.className="attr-fill";
    fill.style.width=scores[i]+"%";
    track.appendChild(fill);
    item.append(head,track);
    list.appendChild(item);
  });

  const chat=document.getElementById("chatMessages");
  chat.innerHTML="";
  result.chat.forEach((message,i)=>{
    addChatMessage(chat,message[0],message[1],i);
  });
  drawRadar(scores);
}

function drawRadar(scores){
  const canvas=document.getElementById("radar");
  const ctx=canvas.getContext("2d");
  const w=canvas.width,h=canvas.height;
  ctx.clearRect(0,0,w,h);
  const cx=w/2,cy=h/2+6;
  const radius=145;
  const n=5;
  const angles=Array.from({length:n},(_,i)=>-Math.PI/2+i*2*Math.PI/n);

  // 背景网格
  for(let level=1;level<=5;level++){
    const r=radius*level/5;
    ctx.beginPath();
    angles.forEach((angle,i)=>{
      const x=cx+Math.cos(angle)*r;
      const y=cy+Math.sin(angle)*r;
      if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
    });
    ctx.closePath();
    ctx.strokeStyle=level===5?"#b58a61":"#d7b896";
    ctx.lineWidth=level===5?2:1;
    ctx.stroke();
  }

  // 轴线与标签
  angles.forEach((angle,i)=>{
    ctx.beginPath();
    ctx.moveTo(cx,cy);
    ctx.lineTo(cx+Math.cos(angle)*radius,cy+Math.sin(angle)*radius);
    ctx.strokeStyle="#c5a17b";
    ctx.lineWidth=1;
    ctx.stroke();

    const labelRadius=radius+29;
    const x=cx+Math.cos(angle)*labelRadius;
    const y=cy+Math.sin(angle)*labelRadius;
    ctx.fillStyle="#70452e";
    ctx.font="bold 19px Microsoft YaHei, sans-serif";
    ctx.textAlign="center";
    ctx.textBaseline="middle";
    ctx.fillText(DIMENSIONS[i],x,y);
  });

  // 用户五维画像
  ctx.beginPath();
  scores.forEach((score,i)=>{
    const r=radius*Math.max(0,Math.min(100,score))/100;
    const x=cx+Math.cos(angles[i])*r;
    const y=cy+Math.sin(angles[i])*r;
    if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
  });
  ctx.closePath();
  ctx.fillStyle="rgba(160,52,39,.48)";
  ctx.strokeStyle="#9c3529";
  ctx.lineWidth=3;
  ctx.fill();
  ctx.stroke();

  scores.forEach((score,i)=>{
    const r=radius*score/100;
    const x=cx+Math.cos(angles[i])*r;
    const y=cy+Math.sin(angles[i])*r;
    ctx.beginPath();
    ctx.arc(x,y,5,0,Math.PI*2);
    ctx.fillStyle="#8c3027";
    ctx.fill();
    ctx.strokeStyle="#f6e7ce";
    ctx.lineWidth=2;
    ctx.stroke();
  });
}

function restartTest(){
  currentQuestion=0;
  answers=Array(QUESTIONS.length).fill(null);
  finalResult=null;
  finalScores=null;
  showScreen("quiz");
  renderQuestion();
}

function buildShareText(){
  if(!finalResult)return "";
  return `我在《嫁金钗》· 人生剧本鉴定所测出了自己的命格！\n\n【${finalResult.title}】\n对应人物：${finalResult.character}\n\n${finalResult.slogan}\n\n我的五维属性：\n${DIMENSIONS.map((d,i)=>d+"："+finalScores[i]).join("｜")}\n\n你在这场命运棋局里会是谁？来测测你的专属人生剧本！\n（原创趣味测试，非剧集官方产品）`;
}

async function copyShare(){
  const text=buildShareText();
  if(!text)return;
  try{
    if(navigator.clipboard&&window.isSecureContext){
      await navigator.clipboard.writeText(text);
    }else{
      const area=document.createElement("textarea");
      area.value=text;
      area.style.position="fixed";
      area.style.left="-9999px";
      document.body.appendChild(area);
      area.select();
      const ok=document.execCommand("copy");
      area.remove();
      if(!ok)throw new Error("copy failed");
    }
    showToast("分享文案已复制，快去分享你的命格！");
  }catch(e){
    showToast("浏览器限制了自动复制，请手动复制结果文字。");
    window.prompt("请复制以下分享文案：",text);
  }
}

function saveResult(){
  /*
   * 无需外部图片库的本地保存方案：
   * 调用浏览器打印对话框，选择“另存为 PDF”即可保存整张结果卡。
   * 如果以后需要一键 PNG，可再添加 html2canvas。
   */
  showToast("正在打开保存界面，请选择“另存为 PDF”保存结果卡。");
  setTimeout(()=>window.print(),350);
}

let toastTimer=null;
function showToast(text){
  const toast=document.getElementById("toast");
  toast.textContent=text;
  toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>toast.classList.remove("show"),2600);
}

// 初始状态
renderQuestion();
</script>
</body>
</html>
